{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whale CeFi Audit Closure Record",
  "type": "object",
  "required": [
    "auditor",
    "report_id",
    "scope_commit",
    "finding_id",
    "status",
    "deployment_coverage"
  ],
  "properties": {
    "auditor": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "remediated",
        "retested",
        "superseded",
        "risk-accepted"
      ]
    },
    "deployment_coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
