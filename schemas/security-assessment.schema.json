{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whale CeFi Security Assessment Record",
  "type": "object",
  "required": [
    "assessment_id",
    "title",
    "version",
    "assessment_type",
    "assurance_provider",
    "provider_relationship",
    "issue_date",
    "status",
    "artifact",
    "scope",
    "finding_summary",
    "automated_revalidation"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "assessment_type": {
      "type": "string",
      "minLength": 1
    },
    "assurance_provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_relationship": {
      "enum": [
        "first-party",
        "second-party",
        "independent-third-party"
      ]
    },
    "independent_third_party_audit": {
      "type": "boolean"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "media_type",
        "pages",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "const": "application/pdf"
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": [
        "environment",
        "production_deployment_coverage"
      ],
      "properties": {
        "baseline_report": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "assurance_grade": {
          "type": "string",
          "minLength": 1
        },
        "reported_source_root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "production_deployment_coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "finding_summary": {
      "type": "object",
      "required": [
        "total",
        "resolved",
        "open"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "automated_revalidation": {
      "type": "object",
      "required": [
        "total_checks",
        "passed",
        "failed"
      ],
      "properties": {
        "total_checks": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_outcome": {
          "type": "string",
          "minLength": 1
        },
        "simulated_principal_loss_usd": {
          "type": "number",
          "minimum": 0
        },
        "event_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "event_chain_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "evidence_pack": {
      "type": "object",
      "required": [
        "status",
        "pdf_embedded_file_count",
        "independent_reproduction_by_documentation_team"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "pdf_embedded_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "independent_reproduction_by_documentation_team": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
